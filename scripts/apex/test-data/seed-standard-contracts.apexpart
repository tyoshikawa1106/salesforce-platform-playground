
List<Account> accounts = [SELECT Id, Name FROM Account WHERE Name LIKE :seedLike ORDER BY CreatedDate ASC LIMIT :parentPoolSize];
List<Contact> contacts = [SELECT Id, FirstName, LastName FROM Contact WHERE LastName LIKE :seedLike ORDER BY CreatedDate ASC LIMIT :parentPoolSize];
List<Opportunity> opportunities = [SELECT Id, AccountId, Pricebook2Id FROM Opportunity WHERE Name LIKE :seedLike ORDER BY CreatedDate ASC LIMIT :parentPoolSize];
List<Campaign> campaigns = [SELECT Id FROM Campaign WHERE Name LIKE '[TEST] 20%' ORDER BY CreatedDate ASC LIMIT :parentPoolSize];
List<PricebookEntry> pricebookEntries = [
    SELECT Id, Pricebook2Id, Product2Id, UnitPrice, Product2.Name, Product2.ProductCode
    FROM PricebookEntry
    WHERE Product2.Name LIKE :seedLike AND Pricebook2.IsStandard = TRUE AND IsActive = TRUE AND Pricebook2.IsActive = TRUE
    ORDER BY CreatedDate ASC
    LIMIT :parentPoolSize
];

if (accounts.isEmpty() || contacts.isEmpty() || pricebookEntries.isEmpty()) {
    System.assert(false, 'Run accounts, contacts, and pricebook entries before contracts.');
}

String status = pick(Contract.Status.getDescribe(), new List<String>{ 'Draft' });
String notice = pick(Contract.OwnerExpirationNotice.getDescribe(), new List<String>{ '30', '60', '90' });
Integer existingCount = [SELECT COUNT() FROM Contract WHERE Account.Name LIKE :seedLike];
List<Contract> records = new List<Contract>();
for (Integer i = 1; i <= countPerObject; i += 1) {
    Integer sequence = existingCount + i;
    records.add(new Contract(AccountId = accounts[Math.mod(sequence - 1, accounts.size())].Id, Pricebook2Id = pricebookEntries[Math.mod(sequence - 1, pricebookEntries.size())].Pricebook2Id, StartDate = Date.today().addDays(Math.mod(sequence, 180)), ContractTerm = 12, Status = status, CustomerSignedId = contacts[Math.mod(sequence - 1, contacts.size())].Id, CustomerSignedTitle = '部門責任者', CustomerSignedDate = Date.today().addDays(Math.mod(sequence, 180)), OwnerExpirationNotice = notice, CompanySignedId = UserInfo.getUserId(), CompanySignedDate = Date.today(), Description = '年間利用契約のドラフト。'));
}
System.debug('Seed run key: ' + seedRunKey);
logResults('Contract', Database.insert(records, false));
