// 取引先責任者と商談へ関連付けた次回アクションを作成
List<Contact> contacts = [SELECT Id FROM Contact WHERE LastName LIKE :seedLike ORDER BY CreatedDate ASC LIMIT :parentPoolSize];
List<Opportunity> opportunities = [SELECT Id FROM Opportunity WHERE Name LIKE :seedLike ORDER BY CreatedDate ASC LIMIT :parentPoolSize];

// 活動の参照先が不足している場合は、先行seedの実行を促す
if (contacts.isEmpty() || opportunities.isEmpty()) {
    System.assert(false, 'Run contacts and opportunities before tasks.');
}

// 組織で利用可能な状態と優先度を使い、期限を分散したToDoを追加
String status = pick(Task.Status.getDescribe(), new List<String>{ 'Not Started', 'Open' });
String priority = pick(Task.Priority.getDescribe(), new List<String>{ 'Normal', 'Medium', 'High' });
List<String> subjects = new List<String>{ 'Call', 'Email', 'Send Letter', 'Send Quote', 'Other' };
Integer existingCount = [SELECT COUNT() FROM Task WHERE Subject LIKE :seedLike];
List<Task> records = new List<Task>();
for (Integer i = 1; i <= countPerObject; i += 1) {
    Integer sequence = existingCount + i;
    records.add(new Task(Subject = seedPrefix + ' ' + subjects[Math.mod(sequence - 1, subjects.size())], WhoId = contacts[Math.mod(sequence - 1, contacts.size())].Id, WhatId = opportunities[Math.mod(sequence - 1, opportunities.size())].Id, Status = status, Priority = priority, ActivityDate = Date.today().addDays(Math.mod(sequence, 180)), Description = '顧客との次回アクションを追跡する検証用ToDo。'));
}
// 部分成功を許可し、作成件数と失敗理由を共通形式で記録
System.debug('Seed run key: ' + seedRunKey);
logResults('Task', Database.insert(records, false));
