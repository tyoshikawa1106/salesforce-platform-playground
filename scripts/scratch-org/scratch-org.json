{
    "alias": "scratch-org",
    "definitionFile": "config/project-scratch-def.json",
    "deploymentPermissionSet": "ScratchOrgMetadataDeployer",
    "durationDays": 7,
    "importPlan": "scripts/setup/plans/import-test-data-plan.json",
    "manifest": "manifest/rebuild-scratch-org.xml",
    "permissionSets": [
        "SalesforceApplicationUser",
        "LwcAccountDataQualityScan",
        "LwcAccountDelete",
        "LwcAccountMassUpdate",
        "LwcAccountPdfExport",
        "LwcCaseEmailMessageList",
        "LwcExternalClientAppManager",
        "LwcObjectExplorer",
        "LwcObjectMetricsOverview",
        "LwcObjectRecordSearch",
        "LwcOrgExplorer",
        "LwcTestDataDelete"
    ],
    "waitMinutes": 30,
    "externalClientApps": [
        {
            "apiName": "InternalSalesforceApi",
            "label": "Salesforce API アクセス（組織内）",
            "scopes": ["Api", "RefreshToken"]
        },
        {
            "apiName": "ExternalClientAppManager",
            "label": "外部クライアントアプリ認証管理",
            "scopes": ["Api", "RefreshToken", "OpenID"]
        }
    ]
}
