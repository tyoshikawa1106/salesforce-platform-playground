{
    "name": "salesforce-app",
    "private": true,
    "version": "1.0.0",
    "description": "Salesforce App",
    "engines": {
        "node": ">=24 <25"
    },
    "scripts": {
        "lint": "eslint \"**/{aura,lwc}/**/*.js\" \"scripts/**/*.js\" --no-error-on-unmatched-pattern",
        "lint:slds": "slds-linter lint force-app/main/default/lwc",
        "test": "npm run test:scripts && npm run test:unit",
        "test:scripts": "node --test scripts/common/test/*.node.js scripts/ci/test/*.node.js scripts/scratch-org/test/*.node.js scripts/docs/test/*.node.js scripts/setup/test/*.node.js scripts/metadata/destructive/test/*.node.js scripts/permissionset-conversion/test/*.node.js scripts/metadata/retrieve/test/*.node.js scripts/org-tests/test/*.node.js",
        "test:unit": "sfdx-lwc-jest",
        "test:unit:watch": "sfdx-lwc-jest --watch",
        "test:unit:debug": "sfdx-lwc-jest --debug",
        "test:unit:coverage": "sfdx-lwc-jest --coverage",
        "code-analyzer": "sf code-analyzer run --rule-selector Recommended --target force-app --output-file logs/code-analyzer/local.json",
        "code-analyzer:ci": "sf code-analyzer run --rule-selector Recommended --target force-app --severity-threshold 3 --output-file logs/code-analyzer/ci.json",
        "docs:check": "node scripts/docs/check-docs.js",
        "data:bulk:results": "cd logs/data-bulk-results && sf data bulk results",
        "setup:data": "node scripts/setup/import-test-data.js",
        "setup:data:dry-run": "node scripts/setup/import-test-data.js --dry-run",
        "sf:destructive": "node scripts/metadata/destructive/destructive.js",
        "sf:convert:profile": "node scripts/permissionset-conversion/convert-profile-to-permissionset.js",
        "sf:verify:permissionsets": "node scripts/permissionset-conversion/verify-deployed-permissionsets.js",
        "sf:retrieve": "node scripts/metadata/retrieve/retrieve.js",
        "sf:test:apex": "node scripts/org-tests/run-apex-tests.js",
        "sf:test:flow": "node scripts/org-tests/run-flow-tests.js",
        "prettier": "prettier --write \"**/*.{cls,cmp,component,css,html,js,json,md,page,trigger,xml,yaml,yml}\"",
        "prettier:verify": "prettier --check \"**/*.{cls,cmp,component,css,html,js,json,md,page,trigger,xml,yaml,yml}\"",
        "prepare": "husky || true",
        "precommit": "lint-staged"
    },
    "devDependencies": {
        "@lwc/eslint-plugin-lwc": "^3.1.0",
        "@prettier/plugin-xml": "^3.4.1",
        "@sa11y/jest": "^8.0.28",
        "@salesforce-ux/slds-linter": "^1.2.1",
        "@salesforce/eslint-config-lwc": "^4.0.0",
        "@salesforce/eslint-plugin-aura": "^3.0.0",
        "@salesforce/eslint-plugin-lightning": "^2.0.0",
        "@salesforce/sfdx-lwc-jest": "^7.9.0",
        "eslint": "^9.39.5",
        "eslint-plugin-import": "^2.31.0",
        "eslint-plugin-jest": "^29.16.6",
        "fast-xml-parser": "^5.11.1",
        "husky": "^9.1.7",
        "lint-staged": "^17.4.1",
        "prettier": "^3.9.6",
        "prettier-plugin-apex": "^2.3.0"
    },
    "overrides": {
        "@babel/core": "^7.29.7",
        "js-yaml": "^4.2.0",
        "postcss": "^8.5.23"
    },
    "lint-staged": {
        "**/*.{cls,cmp,component,css,html,js,json,md,page,trigger,xml,yaml,yml}": [
            "prettier --write"
        ],
        "**/{aura,lwc}/**/*.js": [
            "eslint"
        ],
        "scripts/**/*.js": [
            "eslint"
        ],
        "**/lwc/**": [
            "sfdx-lwc-jest -- --bail --findRelatedTests --passWithNoTests"
        ]
    }
}
